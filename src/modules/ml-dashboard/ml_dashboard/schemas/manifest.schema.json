{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ml_dashboard/manifest.schema.json",
  "title": "artifacts/manifest.json et extra_results/manifest.json (schema_version 1)",
  "type": "object",
  "required": ["schema_version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "title"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string", "pattern": "^[^/\\\\][^\\\\]*$",
                   "description": "Chemin relatif au dossier du manifest, séparateur /."},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "kind": {"enum": ["image", "html", "table"]},
          "created_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
