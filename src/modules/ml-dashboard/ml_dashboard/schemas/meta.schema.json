{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ml_dashboard/meta.schema.json",
  "title": "meta.json — métadonnées d'un run (schema_version 1)",
  "type": "object",
  "required": ["schema_version", "run_id", "project", "task", "model", "framework",
               "seed", "status", "created_at", "ended_at", "duration_s", "environment", "datasets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^\\d{8}_\\d{6}_[a-z0-9][a-z0-9_-]{0,63}$",
               "description": "AAAAMMJJ_HHMMSS_nomcourt ; identique au nom du dossier du run."},
    "project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                "description": "Identifiant du projet ; identique au nom du dossier parent."},
    "task": {"enum": ["classification", "detection", "segmentation"]},
    "model": {"type": "string", "minLength": 1, "description": "Ex. efficientnet_b0, yolov8n-seg, rtdetr-l."},
    "framework": {"type": "string", "minLength": 1, "description": "Ex. pytorch, ultralytics, sklearn."},
    "seed": {"type": ["integer", "null"]},
    "status": {"enum": ["running", "completed", "failed", "interrupted"]},
    "created_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "duration_s": {"type": ["number", "null"], "minimum": 0},
    "best_epoch": {"type": ["integer", "null"], "minimum": 0,
                   "description": "Époque du checkpoint sauvegardé dans model/ (optionnel)."},
    "monitor": {"type": ["string", "null"],
                "description": "Colonne d'epochs.csv ayant servi à choisir best_epoch, ex. val_loss."},
    "environment": {
      "type": "object",
      "required": ["host", "python", "platform", "gpu", "libraries"],
      "additionalProperties": true,
      "properties": {
        "host": {"type": "string", "description": "kaggle | local | colab | autre"},
        "python": {"type": "string"},
        "platform": {"type": "string"},
        "gpu": {"type": ["string", "null"], "description": "Nom du GPU, null si CPU."},
        "libraries": {"type": "object", "additionalProperties": {"type": "string"},
                      "description": "{nom: version} des librairies utiles (torch, timm, ultralytics…)."}
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1,
                      "description": "Version Kaggle, hash, date… tout ce qui permet de retrouver les données."},
          "root": {"type": ["string", "null"],
                   "description": "Racine des images ; image_path des prédictions y est relatif."},
          "n_samples": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": "string"},
    "extra": {"type": "object", "description": "Champs libres propres au projet."}
  }
}
